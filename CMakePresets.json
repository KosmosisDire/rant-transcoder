{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21
  },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio)",
      "description": "Newest installed Visual Studio, Rant from the pinned release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja)",
      "description": "Ninja, Rant from the pinned release",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Ninja)",
      "description": "Ninja, Rant from the pinned release",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "windows-local",
      "inherits": "windows",
      "displayName": "Windows (Visual Studio), local Rant",
      "description": "Rant from the ../rant working tree",
      "cacheVariables": {
        "CPM_rant_SOURCE": "${sourceDir}/../rant"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-local",
      "inherits": "linux",
      "displayName": "Linux (Ninja), local Rant",
      "description": "Rant from the ../rant working tree",
      "cacheVariables": {
        "CPM_rant_SOURCE": "${sourceDir}/../rant"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-local",
      "inherits": "macos",
      "displayName": "macOS (Ninja), local Rant",
      "description": "Rant from the ../rant working tree",
      "cacheVariables": {
        "CPM_rant_SOURCE": "${sourceDir}/../rant"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "configuration": "Release"
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "configuration": "Release"
    },
    {
      "name": "windows-local",
      "configurePreset": "windows-local",
      "configuration": "Release"
    },
    {
      "name": "linux-local",
      "configurePreset": "linux-local",
      "configuration": "Release"
    },
    {
      "name": "macos-local",
      "configurePreset": "macos-local",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-local",
      "configurePreset": "windows-local",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-local",
      "configurePreset": "linux-local",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-local",
      "configurePreset": "macos-local",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
